# Copiez ce fichier en ".env" (même dossier) et remplissez-le.
# Ne JAMAIS partager le fichier .env (ni le coller dans un chat, ni l'envoyer par mail).
#
# Générer un secret aléatoire (une fois par ligne ci-dessous) :
#   docker run --rm python:3.11-slim python -c "import secrets;print(secrets.token_hex(32))"

# Lettres et chiffres uniquement (pas de @ : / # ? dans ce mot de passe)
POSTGRES_PASSWORD=
ORTHANC_PASSWORD=
# 64 caractères aléatoires
JWT_SECRET_KEY=
# Secret indépendant pour authentifier les entrées de la chaîne d’audit (64 caractères hexadécimaux)
AUDIT_HMAC_KEY=

# Premier compte administrateur (créé seulement si la base est vide)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Version d'Orthanc à figer (ex. 24.x.x : vérifier sur Docker Hub)
# L'image Orthanc est épinglée dans docker-compose.yml; modifier uniquement après test.
# ORTHANC_TAG n'est plus utilisé.

# Seuil d'erreur de calage au-delà duquel le logiciel REFUSE le résultat (mm)
REG_MAX_RMS_MM=0.5
# Dispersion maximale entre relances du recalage ICP (mm)
REG_MAX_SPREAD_MM=0.3
# Durée de conservation des modèles 3D temporaires (jours)
RESULTS_RETENTION_DAYS=7

# Origines web autorisées, séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Taille maximale individuelle d’un fichier DICOM (octets)
MAX_DICOM_FILE_BYTES=268435456

# Nom DNS public pour Caddy (HTTPS automatique)
DENTALCAD_HOST=dentalcad.example.org
# Limite globale partagée Redis
MAX_REQUESTS_PER_MINUTE=120
