{$DENTALCAD_HOST} {
    encode zstd gzip
    @api path /api/* /health
    handle @api {
        reverse_proxy 127.0.0.1:8010
    }
    handle {
        reverse_proxy 127.0.0.1:5173
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
}
